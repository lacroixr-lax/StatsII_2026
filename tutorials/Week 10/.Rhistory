## heckman
install.packages("sampleSelection")
library(sampleSelection)
new_data <- data("Mroz87")
# OLS
summary(lm(wage ~ educ + exper + age + kids5, data = Mroz87))
View(Mroz87)
# Heckman
heck <- selection(
selection = lfp ~ educ + exper + age + kids5,
outcome = wage ~ educ + exper + age + kids5,
data = Mroz87
)
summary(heck)
