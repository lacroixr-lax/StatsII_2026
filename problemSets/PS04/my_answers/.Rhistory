lapply(c("nnet", "MASS", "survival", "eha", "tidyverse", "ggfortify", "stargazer", "VGAM"),  pkgTest)
# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# load data on child mortality by mother's background and child gender
data("child", package = "eha")
# set survival of children
child_surv <- with(child, Surv(enter, exit, event))
# fit cox proportional hazard model
cox <- coxph(child_surv ~ m.age + sex, data = child)
summary(cox)
child_surv
# output table
stargazer(cox, type = "latex",
title = "Cox Proportional Hazard Model",
deep.var.labels = "Survival")
# output table
stargazer(cox, type = "latex",
title = "Cox Proportional Hazard Model")
?child
?Surv
lapply(c("nnet", "MASS", "survival", "eha", "tidyverse", "ggfortify",
"stargazer", "VGAM", "sampleSelection"),  pkgTest)
# load data
disaster_data <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/refs/heads/main/datasets/disaster_response.csv")
View(disaster_data)
?selection
unique(disaster_data$binContribution)
# heckman selection model
heck_selection <- selection(
selection = binContribution ~ occurrences + deathsEM +
normalizedDamageEMLogged,
outcome = originalContributionMillionsUSDLogged ~ occurrences + deathsEM +
normalizedDamageEMLogged,
data = disaster_data
)
# heckman selection model
heck_selection <- selection(
selection = binContribution ~ occurrences + deathsEM +
normalizedDamageEMLogged,
outcome = originalContributionMillionUSDLogged ~ occurrences + deathsEM +
normalizedDamageEMLogged,
data = disaster_data
)
# heckman selection model
heck <- selection(
selection = binContribution ~ occurrences + deathsEM +
normalizedDamageEMLogged,
outcome = originalContributionMillionUSDLogged ~ occurrences + deathsEM +
normalizedDamageEMLogged,
data = disaster_data
)
summary(heck)
# output table
stargazer(heck, type = "latex",
titel = "Heckamn Selection Model",
deep.var.labels = c("Selection", "Outcome"))
# output table
stargazer(heck, type = "latex",
title = "Heckamn Selection Model",
deep.var.labels = c("Selection", "Outcome"))
# output table
stargazer(heck, type = "latex",
title = "Heckamn Selection Model")
lapply(c("nnet", "MASS", "survival", "eha", "tidyverse", "ggfortify",
"stargazer", "VGAM", "sampleSelection", "texreg"),  pkgTest)
texreg(heck, caption = "Heckman Selection Model")
s <- summary(heck)
# Extract all coefficients (both equations)
coefs <- coef(s)
all_coefs  <- coefs[, 1]
all_ses    <- coefs[, 2]
all_pvals  <- coefs[, 4]
stargazer(heck,
coef   = list(all_coefs),
se     = list(all_ses),
p      = list(all_pvals),
covariate.labels = names(all_coefs),
type = "latex",
title = "Heckman Selection Model (Both Equations)")
# output table
texreg(heck, caption = "Heckman Selection Model")
# output table
texreg(heck, caption = "Heckman Selection Model",
label = "tab:heckman",
booktabs = TRUE)
texreg(fit,
caption = "Heckman Selection Model",
label   = "tab:heckman",
booktabs = TRUE,
# Rename variables
custom.coef.names = c(
"S: Intercept",
"S: Occurrences",
"S: Deaths (EM)",
"S: Normalized Damage (log)",
"O: Intercept",
"O: Occurrences",
"O: Deaths (EM)",
"O: Normalized Damage (log)",
"$\\sigma$",
"$\\rho$"
),
# Rename fit statistics
custom.gof.names = c("AIC", "BIC", "Log Likelihood",
"Num. obs.", "Censored", "Observed"),
# Control decimal places
digits = 3,
# Add a horizontal rule to separate equations
custom.note = "\\midrule \n \\multicolumn{2}{l}{\\textit{Note:} S = Selection equation; O = Outcome equation.} \\\\ \n $^{***}p<0.001$; $^{**}p<0.01$; $^{*}p<0.05$"
)
